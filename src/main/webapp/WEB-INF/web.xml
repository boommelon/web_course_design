<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>毕业设计管理系统</display-name>

    <!-- ========== 过滤器配置 ========== -->

    <!-- 编码过滤器 -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 登录验证与权限过滤器 -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ========== Servlet配置 ========== -->

    <!-- 登录 -->
    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>controller.LoginController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/login.action</url-pattern>
    </servlet-mapping>

    <!-- 仪表盘 -->
    <servlet>
        <servlet-name>DashboardController</servlet-name>
        <servlet-class>controller.DashboardController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardController</servlet-name>
        <url-pattern>/dashboard.action</url-pattern>
    </servlet-mapping>

    <!-- 个人资料与密码修改 -->
    <servlet>
        <servlet-name>ProfileController</servlet-name>
        <servlet-class>controller.ProfileController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileController</servlet-name>
        <url-pattern>/profile.action</url-pattern>
    </servlet-mapping>

    <!-- 管理员-用户管理 -->
    <servlet>
        <servlet-name>AdminUserController</servlet-name>
        <servlet-class>controller.AdminUserController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUserController</servlet-name>
        <url-pattern>/admin/users.action</url-pattern>
    </servlet-mapping>

    <!-- 管理员-基础数据导入 -->
    <servlet>
        <servlet-name>AdminImportController</servlet-name>
        <servlet-class>controller.AdminImportController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminImportController</servlet-name>
        <url-pattern>/admin/import.action</url-pattern>
    </servlet-mapping>

    <!-- 管理员-公告管理 -->
    <servlet>
        <servlet-name>AdminAnnouncementController</servlet-name>
        <servlet-class>controller.AdminAnnouncementController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminAnnouncementController</servlet-name>
        <url-pattern>/admin/announcements.action</url-pattern>
    </servlet-mapping>

    <!-- 管理员-课题审核 -->
    <servlet>
        <servlet-name>AdminTopicReviewController</servlet-name>
        <servlet-class>controller.AdminTopicReviewController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminTopicReviewController</servlet-name>
        <url-pattern>/admin/topics.action</url-pattern>
    </servlet-mapping>

    <!-- 管理员-系统流程开关 -->
    <servlet>
        <servlet-name>AdminSystemSettingController</servlet-name>
        <servlet-class>controller.AdminSystemSettingController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminSystemSettingController</servlet-name>
        <url-pattern>/admin/settings.action</url-pattern>
    </servlet-mapping>

    <!-- 管理员-在线选题管理 -->
    <servlet>
        <servlet-name>AdminSelectionController</servlet-name>
        <servlet-class>controller.AdminSelectionController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminSelectionController</servlet-name>
        <url-pattern>/admin/selections.action</url-pattern>
    </servlet-mapping>

    <!-- 管理员-教师分组 -->
    <servlet>
        <servlet-name>AdminGroupController</servlet-name>
        <servlet-class>controller.AdminGroupController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminGroupController</servlet-name>
        <url-pattern>/admin/groups.action</url-pattern>
    </servlet-mapping>

    <!-- 管理员-文档管理 -->
    <servlet>
        <servlet-name>AdminDocumentController</servlet-name>
        <servlet-class>controller.AdminDocumentController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDocumentController</servlet-name>
        <url-pattern>/admin/documents.action</url-pattern>
    </servlet-mapping>

    <!-- 管理员-文件模板管理 -->
    <servlet>
        <servlet-name>AdminTemplateController</servlet-name>
        <servlet-class>controller.AdminTemplateController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminTemplateController</servlet-name>
        <url-pattern>/admin/templates.action</url-pattern>
    </servlet-mapping>

    <!-- 管理员-答辩结束与归档 -->
    <servlet>
        <servlet-name>AdminArchiveController</servlet-name>
        <servlet-class>controller.AdminArchiveController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminArchiveController</servlet-name>
        <url-pattern>/admin/archive.action</url-pattern>
    </servlet-mapping>

    <!-- 教师-课题管理 -->
    <servlet>
        <servlet-name>TeacherTopicController</servlet-name>
        <servlet-class>controller.TeacherTopicController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherTopicController</servlet-name>
        <url-pattern>/teacher/topics.action</url-pattern>
    </servlet-mapping>

    <!-- 教师-选题审批 -->
    <servlet>
        <servlet-name>TeacherSelectionController</servlet-name>
        <servlet-class>controller.TeacherSelectionController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherSelectionController</servlet-name>
        <url-pattern>/teacher/selections.action</url-pattern>
    </servlet-mapping>

    <!-- 教师-文档审核 -->
    <servlet>
        <servlet-name>TeacherDocumentController</servlet-name>
        <servlet-class>controller.TeacherDocumentController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherDocumentController</servlet-name>
        <url-pattern>/teacher/documents.action</url-pattern>
    </servlet-mapping>

    <!-- 教师-任务管理 -->
    <servlet>
        <servlet-name>TeacherTaskController</servlet-name>
        <servlet-class>controller.TeacherTaskController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherTaskController</servlet-name>
        <url-pattern>/teacher/tasks.action</url-pattern>
    </servlet-mapping>

    <!-- 教师-资料管理 -->
    <servlet>
        <servlet-name>TeacherResourceController</servlet-name>
        <servlet-class>controller.TeacherResourceController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherResourceController</servlet-name>
        <url-pattern>/teacher/resources.action</url-pattern>
    </servlet-mapping>

    <!-- 教师-答疑管理 -->
    <servlet>
        <servlet-name>TeacherQuestionController</servlet-name>
        <servlet-class>controller.TeacherQuestionController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherQuestionController</servlet-name>
        <url-pattern>/teacher/questions.action</url-pattern>
    </servlet-mapping>

    <!-- 教师-答辩评分 -->
    <servlet>
        <servlet-name>TeacherDefenseController</servlet-name>
        <servlet-class>controller.TeacherDefenseController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherDefenseController</servlet-name>
        <url-pattern>/teacher/defense.action</url-pattern>
    </servlet-mapping>

    <!-- 教师-自评互评成绩 -->
    <servlet>
        <servlet-name>TeacherEvaluationController</servlet-name>
        <servlet-class>controller.TeacherEvaluationController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherEvaluationController</servlet-name>
        <url-pattern>/teacher/evaluations.action</url-pattern>
    </servlet-mapping>

    <!-- 学生-浏览课题 -->
    <servlet>
        <servlet-name>StudentTopicController</servlet-name>
        <servlet-class>controller.StudentTopicController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentTopicController</servlet-name>
        <url-pattern>/student/topics.action</url-pattern>
    </servlet-mapping>

    <!-- 学生-我的选题 -->
    <servlet>
        <servlet-name>StudentSelectionController</servlet-name>
        <servlet-class>controller.StudentSelectionController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentSelectionController</servlet-name>
        <url-pattern>/student/selections.action</url-pattern>
    </servlet-mapping>

    <!-- 学生-文档提交 -->
    <servlet>
        <servlet-name>StudentDocumentController</servlet-name>
        <servlet-class>controller.StudentDocumentController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentDocumentController</servlet-name>
        <url-pattern>/student/documents.action</url-pattern>
    </servlet-mapping>

    <!-- 学生-我的成绩 -->
    <servlet>
        <servlet-name>StudentScoreController</servlet-name>
        <servlet-class>controller.StudentScoreController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentScoreController</servlet-name>
        <url-pattern>/student/scores.action</url-pattern>
    </servlet-mapping>

    <!-- 学生-任务资料 -->
    <servlet>
        <servlet-name>StudentResourceController</servlet-name>
        <servlet-class>controller.StudentResourceController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentResourceController</servlet-name>
        <url-pattern>/student/resources.action</url-pattern>
    </servlet-mapping>

    <!-- 学生-提问管理 -->
    <servlet>
        <servlet-name>StudentQuestionController</servlet-name>
        <servlet-class>controller.StudentQuestionController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentQuestionController</servlet-name>
        <url-pattern>/student/questions.action</url-pattern>
    </servlet-mapping>

    <!-- 文档附件下载 -->
    <servlet>
        <servlet-name>DocumentDownloadController</servlet-name>
        <servlet-class>controller.DocumentDownloadController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DocumentDownloadController</servlet-name>
        <url-pattern>/documents/download.action</url-pattern>
    </servlet-mapping>

    <!-- 模板与资料下载 -->
    <servlet>
        <servlet-name>ResourceDownloadController</servlet-name>
        <servlet-class>controller.ResourceDownloadController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResourceDownloadController</servlet-name>
        <url-pattern>/resources/download.action</url-pattern>
    </servlet-mapping>

    <!-- ========== 欢迎页 ========== -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

</web-app>
